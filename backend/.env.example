# Copy to .env and fill in. Never commit .env (it holds the database password).

# ---- Database (backend only) ----
MONGO_URI=mongodb://USER:PASSWORD@host1:27017,host2:27017/pratham?ssl=true&replicaSet=...&authSource=admin
MONGO_DB=pratham

# ---- API server ----
PORT=4100
# 0.0.0.0 = phones on the Wi-Fi can open it. On a server behind nginx use 127.0.0.1.
HOST=0.0.0.0
# Access key every device (browser, phone app) must enter.
ANALYTICS_TOKEN=
# true = requests from this same computer skip the key. Keep false on a server behind nginx.
TRUST_LOCALHOST=false
# Extra web origins allowed to call the API directly, comma separated (e.g. https://analytics.mrpscan.com).
# Empty = none (not needed when the web app is served on the same port).
CORS_ORIGINS=
# true = this server also serves the web app (frontend/dist), so everything runs on PORT.
SERVE_FRONTEND=true
