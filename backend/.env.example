# Copy to .env and fill in. Never commit .env (it holds the database password).

# ---- Database ----
MONGO_URI=mongodb://USER:PASSWORD@host1:27017,host2:27017/pratham?ssl=true&replicaSet=...&authSource=admin
MONGO_DB=pratham

# ---- API server (data only; the web app is the separate frontend project) ----
PORT=4000
# 0.0.0.0 = reachable from other machines. 127.0.0.1 = only this machine (e.g. frontend on the same server).
HOST=0.0.0.0
# Access key every device (browser, phone app) must enter.
ANALYTICS_TOKEN=
# true = requests from this same computer skip the key (laptop only). Keep false on a server.
TRUST_LOCALHOST=false
# Frontend addresses allowed to call this API directly from the browser, comma separated.
# Needed when frontend/.env API_URL points here. Empty = only via the frontend server.
CORS_ORIGINS=http://localhost:4100,http://127.0.0.1:4100,http://analytics.mrpscan.com,https://analytics.mrpscan.com
