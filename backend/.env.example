# Copy to .env and fill in. Never commit .env (it holds the database password).

# ---- Database ----
MONGO_URI=mongodb://USER:PASSWORD@host1:27017,host2:27017/pratham?ssl=true&replicaSet=...&authSource=admin
MONGO_DB=pratham

# ---- Server: web app at /, data API at /api ----
PORT=4000
# 0.0.0.0 = reachable from other machines. 127.0.0.1 = only this machine (e.g. frontend on the same server).
HOST=0.0.0.0
# Access key every device (browser, phone app) must enter.
ANALYTICS_TOKEN=
# true = requests from this same computer skip the key (laptop only). Keep false on a server.
TRUST_LOCALHOST=false
# Web app addresses allowed to call this API from the browser, comma separated.
# Leave the line out to use the built-in list (analytics.mrpscan.com + local ports 4000/4100).
CORS_ORIGINS=https://analytics.mrpscan.com,http://localhost:4100,http://127.0.0.1:4100
# true (default) = opening this server shows the web app (built from ../frontend). false = API only.
SERVE_FRONTEND=true
