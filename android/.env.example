# Copy to .env and adjust, then rebuild the APK. Nothing secret lives here.
# ---- Android app (read at build time by app/build.gradle) ----
# Name under the phone icon.
APP_NAME=MRPanalytics
# Address the phone app opens (the frontend web app), e.g. https://analytics.mrpscan.com
# Empty = this computer's Wi-Fi address + SERVER_PORT.
SERVER_URL=
# Frontend port used when SERVER_URL is empty.
SERVER_PORT=4100
