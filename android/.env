# ---- Android app (read at build time by app/build.gradle) ----
# Name under the phone icon.
APP_NAME=MRPanalytics
# Address the phone app opens (the frontend web app). Empty = this computer's Wi-Fi address + SERVER_PORT.
SERVER_URL=http://analytics.mrpscan.com/
# Frontend port used when SERVER_URL is empty.
SERVER_PORT=4100
