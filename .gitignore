# Dependencies
node_modules/

# Secrets: the backend .env holds the database password and access key. Never commit it.
.env
backend/.env
# Web and app settings hold no secrets, so they are shared.
!frontend/.env
!android/.env

# Build output
frontend/dist/
android/.gradle/
android/build/
android/app/build/
android/local.properties
*.apk

# Android signing key (keep a private backup; needed for every app update)
android/keystore.properties
android/app/keystore/

# Screenshots show real users' phone numbers and GST (repo is public)
screenshots/
