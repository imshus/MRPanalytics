# ---- App branding ----
APP_NAME=MRPanalytics

# ---- Web server ----
# Optional dev server port. Normally the backend serves this web app on its own port.
FRONTEND_PORT=5173
# Where the frontend server forwards /api requests (the backend).
BACKEND_URL=http://127.0.0.1:4100
# API address used by the browser. Empty = same address as the web app (/api is forwarded).
API_URL=http://analytics.mrpscan.com/

