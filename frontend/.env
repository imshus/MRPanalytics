# ---- App branding ----
APP_NAME=MRPanalytics

# ---- Web server ----
# Port the web app (and the phone app) opens.
FRONTEND_PORT=4100
# Backend address the frontend server forwards /api to (used when API_URL is empty).
BACKEND_URL=https://analytics.mrpscan.com
# Backend address the BROWSER calls directly. Empty = call /api on the web app address (forwarded).
API_URL=https://analytics.mrpscan.com

