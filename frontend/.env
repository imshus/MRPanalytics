# ---- App branding ----
APP_NAME=MRPanalytics

# ---- Web server ----
# Port the web app (and the phone app) opens.
FRONTEND_PORT=4100
# Where the frontend server forwards /api requests (the backend).
BACKEND_URL=http://127.0.0.1:4000
# API address used by the browser. Empty = same address as the web app (/api is forwarded).
API_URL=

