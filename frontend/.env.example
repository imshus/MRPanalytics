# Copy to .env and adjust. Nothing secret lives here.

# ---- App branding ----
APP_NAME=MRPanalytics

# ---- Web server (the web app; the backend is a separate project) ----
# Port the web app (and the phone app) opens.
FRONTEND_PORT=4100
# Backend address the frontend server forwards /api to (used when API_URL is empty).
BACKEND_URL=http://127.0.0.1:4000
# Backend address the BROWSER calls directly, e.g. http://localhost:4000 or https://api.example.com.
# Empty = the browser calls /api on the web app's own address and the frontend server forwards it.
# When set, add this web app's address to the backend's CORS_ORIGINS.
API_URL=
